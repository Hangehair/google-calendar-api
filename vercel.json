{
  "version": 2,
  "builds": [
    {
      "src": "api_booking.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api_booking.py"
    }
  ],
  "env": {
    "CALENDAR_ID": "@calendar_id",
    "GOOGLE_CREDENTIALS_JSON": "@google_credentials_json",
    "TIMEZONE": "Asia/Taipei"
  }
}
