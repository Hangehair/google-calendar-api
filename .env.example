# Google Calendar API 設定

# ==========================================
# 基本設定
# ==========================================

# Google Calendar ID (通常是你的 Gmail 地址)
CALENDAR_ID=your-email@gmail.com

# 時區設定
TIMEZONE=Asia/Taipei

# ==========================================
# Google 服務帳戶憑證（三種方式任選一）
# ==========================================

# 方法 1：完整的 JSON 憑證（推薦用於雲端部署）
# 將整個 credentials.json 的內容複製為一行，並貼上在這裡
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@project.iam.gserviceaccount.com"}'

# 方法 2：個別變數（更容易管理）
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# 注意：私鑰中的換行需要使用 \\n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nMIIEvgIBADANBgk...\\n-----END PRIVATE KEY-----\\n"

# 方法 3：使用本地 credentials.json 檔案（本地開發用）
# 不需設定任何環境變數，只要將 credentials.json 放在專案根目錄

# ==========================================
# 使用建議
# ==========================================
# 
# 本地開發：使用方法 3（credentials.json 檔案）
# 雲端部署：使用方法 1 或方法 2
# GitHub Actions：使用方法 2（設定在 Secrets）
# Docker/Heroku：使用方法 1
#
